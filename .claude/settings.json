{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(mcp__flylab__.*|Agent|Task|Skill)$",
        "hooks": [{"type": "command", "command": "python .claude/hooks/log_tool_event.py", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(mcp__flylab__.*|Agent|Task|Skill)$",
        "hooks": [{"type": "command", "command": "python .claude/hooks/log_tool_event.py", "timeout": 10}]
      }
    ]
  },
  "enabledMcpjsonServers": ["flylab"],
  "permissions": {
    "allow": ["mcp__flylab"]
  }
}
